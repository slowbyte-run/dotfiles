	<content><![CDATA[
vector<int> primes;
vector<bool> is_prime(N, true);

void seive() {
	is_prime[0] = is_prime[1] = false;

	fer(i, 2, N) {
		if(is_prime[i]) primes.push_back(i);
		for(int j = 0; j < primes.size() && primes[j] * i < N; j++) {
			is_prime[primes[j] * i] = false;
			if(i % primes[j] == 0) break;
		}
	}
}
]]></content>
